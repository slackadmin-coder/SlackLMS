{
  "display_information": {
    "name": "RWR LMS Bot",
    "description": "Slack-based LMS for onboarding and daily lesson delivery",
    "background_color": "#2E3A59"
  },
  "features": {
    "bot_user": {
      "display_name": "RWR LMS",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/lesson",
        "url": "https://script.google.com/macros/s/AKfycbxACBb8JvIStCL87-OLdKgxM2axtxRtCfzCW9XAT6m-j6oF7M-mFMBASjTDhG7N6P2r/exec",
        "description": "Get your current lesson",
        "should_escape": false
      },
      {
        "command": "/submit",
        "url": "https://script.google.com/macros/s/AKfycbxACBb8JvIStCL87-OLdKgxM2axtxRtCfzCW9XAT6m-j6oF7M-mFMBASjTDhG7N6P2r/exec",
        "description": "Submit a completed lesson",
        "should_escape": false
      },
      {
        "command": "/progress",
        "url": "https://script.google.com/macros/s/AKfycbxACBb8JvIStCL87-OLdKgxM2axtxRtCfzCW9XAT6m-j6oF7M-mFMBASjTDhG7N6P2r/exec",
        "description": "Check your progress",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "im:write",
        "im:history",
        "app_mentions:read",
        "commands"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://script.google.com/macros/s/AKfycbxACBb8JvIStCL87-OLdKgxM2axtxRtCfzCW9XAT6m-j6oF7M-mFMBASjTDhG7N6P2r/exec",
      "bot_events": [
        "message.im",
        "app_mention"
      ]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://script.google.com/macros/s/AKfycbxACBb8JvIStCL87-OLdKgxM2axtxRtCfzCW9XAT6m-j6oF7M-mFMBASjTDhG7N6P2r/exec"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
