T*
() Tj
T*
(  handleSlashCommand\(parsed\) {) Tj
T*
(    if \(!parsed || !parsed.command\) {) Tj
T*
(      return { response_type: 'ephemeral', text: 'Missing slash command context.' };) Tj
T*
(    }) Tj
T*
(    var handler = this._slashRegistry[parsed.command];) Tj
T*
(    if \(!handler\) return { response_type: 'ephemeral', text: 'Unsupported command: ' + parsed.command };) Tj
T*
(    return handler\(parsed\);) Tj
T*
(  }) Tj
T*
() Tj
T*
(  handleInteractivity\(parsed\) {) Tj
T*
(    var payload = parsed.interaction || {};) Tj
T*
(    var action = \(payload.actions && payload.actions[0]\) || {};) Tj
T*
(    var actionId = action.action_id || '';) Tj
T*
(    var type = payload.type || '';) Tj
T*
() Tj
T*
(    if \(type === 'view_submission'\) {) Tj
T*
(      return this._handleModalSubmission\(payload\);) Tj
T*
(    }) Tj
T*
() Tj
T*
(    if \(actionId.indexOf\('checklist_mark_'\) === 0\) {) Tj
T*
(      var checklistItemId = actionId.replace\('checklist_mark_', ''\);) Tj
T*
(      var learnerId = payload.user && payload.user.id;) Tj
T*
(      var status = \(action.value || 'completed'\);) Tj
T*
(      var advanced = this._onboarding.advanceOnboardingState\(learnerId, checklistItemId, status\);) Tj
T*
(      return { response_type: 'ephemeral', text: advanced.ok ? ':white_check_mark: Checklist updated.' : \(advanced.message || 'Checklist update failed.'\) };) Tj
T*
(    }) Tj
T*
() Tj
T*
(    if \(actionId === 'submit_lesson'\) {) Tj
T*
(      var lessonId = this._security.sanitizeInput\(action.value || ''\);) Tj
T*
(      var submit = this._completion.recordSubmission\({) Tj
T*
(        slackUserId: parsed.userId,) Tj
T*
(        lessonId: lessonId,) Tj
T*
(        payload: JSON.stringify\(payload\)) Tj
T*
(      }\);) Tj
T*
(      return { response_type: 'ephemeral', text: submit.ok ? ':white_check_mark: Lesson submitted.' : \(submit.message || submit.error_code\) };) Tj
T*
(    }) Tj
T*
() Tj
T*
(    return { response_type: 'ephemeral', text: 'Action received. Use /help to see supported actions.' };) Tj
T*
(  }) Tj
T*
() Tj
T*
(  handleEventCallback\(parsed\) {) Tj
T*
(    var event = \(parsed.body && parsed.body.event\) ? parsed.body.event : {};) Tj
