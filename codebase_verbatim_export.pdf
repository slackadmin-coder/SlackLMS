T*
(      };) Tj
T*
(    }) Tj
T*
(    if \(event.type === 'message' && event.channel_type === 'im'\) {) Tj
T*
(      return this._handleDm\(event\);) Tj
T*
(    }) Tj
T*
(    return { ok: true, text: 'Event ignored', eventType: event.type || '' };) Tj
T*
(  }) Tj
