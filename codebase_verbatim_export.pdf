T*
(function logAuditExact_\(entry\) {) Tj
T*
(  Logger.log\(JSON.stringify\(sanitizeObjectForLog_\(entry || {}\)\)\);) Tj
T*
(}) Tj
T*
() Tj
T*
(function safeError_\(err\) {) Tj
T*
(  return \(err && err.message\) ? String\(err.message\) : String\(err\);) Tj
T*
(}) Tj
T*
() Tj
T*
(function sanitizeObjectForLog_\(obj\) {) Tj
T*
(  var clean = {};) Tj
T*
(  Object.keys\(obj || {}\).forEach\(function\(key\) {) Tj
T*
(    var lower = String\(key\).toLowerCase\(\);) Tj
T*
(    if \(lower.indexOf\('token'\) !== -1 || lower.indexOf\('secret'\) !== -1 || lower.indexOf\('authorization'\) !== -1\) {) Tj
T*
(      clean[key] = '[REDACTED]';) Tj
T*
(      return;) Tj
T*
(    }) Tj
T*
(    clean[key] = String\(obj[key] == null ? '' : obj[key]\);) Tj
T*
(  }\);) Tj
T*
(  return clean;) Tj
T*
(}) Tj
