T*
(    sink: function\(entry\) {) Tj
T*
(      try {) Tj
T*
(        db.table\('audit_log'\).insert\({) Tj
T*
(          actor: entry.actor || 'system',) Tj
T*
(          action: entry.action,) Tj
T*
(          resourceType: entry.table || '',) Tj
