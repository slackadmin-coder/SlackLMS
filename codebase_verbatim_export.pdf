(    var verified = SlackSecurity.verify\(parsed, config\);) Tj
T*
() Tj
T*
(    if \(!verified.ok\) {) Tj
T*
(      deps.audit\('request_denied', {) Tj
T*
(        correlationId: correlationId,) Tj
T*
(        code: verified.code || verified.error_code,) Tj
T*
(        routeType: parsed.routeType) Tj
T*
(      }\);) Tj
T*
(      return jsonResponse_\(verified\);) Tj
T*
(    }) Tj
T*
() Tj
T*
(    var routed = SlackRouter.route\(parsed, deps\);) Tj
T*
(    deps.audit\('request_routed', {) Tj
T*
(      correlationId: correlationId,) Tj
T*
(      routeType: parsed.routeType,) Tj
T*
(      ok: !!routed.ok,) Tj
