T*
(}) Tj
T*
() Tj
T*
(function doPost\(e\) {) Tj
T*
(  var correlationId = 'req_' + new Date\(\).getTime\(\) + '_' + Math.random\(\).toString\(36\).slice\(2, 8\);) Tj
T*
(  try {) Tj
T*
(    var config = resolveHostConfig\(\);) Tj
T*
(    var deps = createHostDependencies\(config\);) Tj
T*
(    var parsed = SlackPayloadParser.parse\(e\);) Tj
