T*
(    this._configRepo = configRepo;) Tj
T*
(    this._slashRegistry = {) Tj
T*
(      '/learn': this._lesson.handleLesson.bind\(this._lesson\),) Tj
T*
(      '/submit': this._completion.handleSubmit.bind\(this._completion\),) Tj
T*
(      '/progress': this._progress.handleProgress.bind\(this._progress\),) Tj
T*
(      '/help': this._handleHelp.bind\(this\),) Tj
T*
